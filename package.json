{
  "name": "crossword-duel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two-player real-time competitive crossword game.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,gray \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "grid:stress": "tsx scripts/grid-stress-test.ts",
    "grid:demo": "tsx scripts/grid-demo.ts",
    "words:check": "tsx scripts/check-words.ts",
    "ai:check": "tsx scripts/ai-check.ts",
    "words:define": "tsx scripts/build-definitions.ts",
    "words:fill": "tsx scripts/build-fill-words.ts",
    "daily:build": "tsx scripts/build-daily-grids.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "word-list": "^4.1.0",
    "wordnet-db": "^3.1.14"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  }
}
